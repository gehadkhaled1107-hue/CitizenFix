#  BINARY S
# s Complaints by Created Date

class DateBinarySearch:

    def __init__(self, complaints=None):
        self.complaints = []

        if complaints:
            self.set_complaints(complaints)

    def set_complaints(self, complaints):
        complaints_list = list(complaints)
        n = len(complaints_list)
        for i in range(1, n):
            key_complaint = complaints_list[i]
            j = i - 1
            while j >= 0 and complaints_list[j].created_at > key_complaint.created_at:
                complaints_list[j + 1] = complaints_list[j]
                j -= 1
            complaints_list[j + 1] = key_complaint
        self.complaints = complaints_list

    def search(self, target_date):
        if isinstance(target_date, str):
            target_date = datetime.strptime(target_date, "%Y-%m-%d").date()

        elif isinstance(target_date, datetime):
            target_date = target_date.date()
        left = 0
        right = len(self.complaints) - 1

        while left <= right:
            mid = (left + right) // 2
            current_date = self.complaints[mid].created_at.date()
            if current_date == target_date:
                left_bound = mid
                i = mid - 1
                while i >= 0:
                    if self.complaints[i].created_at.date() == target_date:
                        left_bound = i
                        i -= 1
                    else:
                        break
                right_bound = mid
                i = mid + 1
                while i < len(self.complaints):
                    if self.complaints[i].created_at.date() == target_date:
                        right_bound = i
                        i += 1
                    else:
                        break
                return self.complaints[left_bound: right_bound + 1]

            elif current_date < target_date:
                left = mid + 1
            else:
                right = mid - 1
        return []


#  SEQUENTIAL S
# S Complaints by Category

class CategorySequentialSearch:

    def __init__(self, complaints=None):
        self.complaints = complaints if complaints else []

    def set_complaints(self, complaints):
        self.complaints = complaints

    def search(self, category):
        results = []
        for complaint in self.complaints:

            if complaint.category.lower() == category.lower():
                results.append(complaint)

        return results


