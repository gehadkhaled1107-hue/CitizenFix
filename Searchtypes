class CustomHashTable:
    def __init__(self, size=10):
        self.size = size
        self.table = [[] for _ in range(size)]
    def hash(self, key):
        key = str(key)
        hash_value = 0
        for char in key:
            hash_value += ord(char)
        return hash_value % self.size

    def put(self, key, value):
        key = str(key)
        index = self.hash(key)
        for item in self.table[index]:
            if item[0] == key:
                item[1] = value
                return
        self.table[index].append([key, value])

    def get(self, key):
        key = str(key)
        index = self.hash(key)
        for item in self.table[index]:
            if item[0] == key:
                return item[1]

        return None



# hash lookup
# s citizen complaints by phone number

class PhoneHashSearch:

    def __init__(self, complaints):
        self.complaints = complaints
        self.phone_hash = CustomHashTable()
        self.build_hash()

    def build_hash(self):
        for complaint in self.complaints:
            phone = complaint.phone
            existing = self.phone_hash.get(phone)
            if existing is None:
                existing = []
            existing.append(complaint)
            self.phone_hash.put(phone, existing)

    def search(self, phone):
        return self.phone_hash.get(phone) or []

